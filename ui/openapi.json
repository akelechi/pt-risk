              },
              {
                "type": "null"
              }
            ],
            "title": "Oil Permit Hours Per Year H"
          },
          "oil_tank_capacity_bbl": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oil Tank Capacity Bbl"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "solver": {
            "default": "price_taker",
            "title": "Solver",
            "type": "string"
          },
          "solver_comparison": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SolverSummary"
            },
            "title": "Solver Comparison",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "scenario",
          "config_hash",
          "data_snapshot_ids",
          "code_version",
          "seed",
          "ledger_hash",
          "ledger_entry_count",
          "inputs",
          "invariants",
          "assumed_parameter_count",
          "ledger_totals_usd",
          "energy_margin_usd"
        ],
        "title": "RunMeta",
        "type": "object"
      },
      "RunSummary": {
        "description": "One stored run, for pickers. Response item of GET /runs.",
        "properties": {
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "energy_margin_usd": {
            "title": "Energy Margin Usd",
            "type": "number"
          },
          "ledger_entry_count": {
            "title": "Ledger Entry Count",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenario_name": {
            "title": "Scenario Name",
            "type": "string"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "unit_ids": {
            "items": {
              "type": "string"
            },
            "title": "Unit Ids",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "scenario_name",
          "start_date",
          "end_date",
          "unit_ids",
          "ledger_entry_count",
          "energy_margin_usd"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "Scenario": {
        "additionalProperties": false,
        "description": "Everything that defines a run. Time comes from here, never from the wall clock.",
        "properties": {
          "availability": {
            "default": "derated",
            "enum": [
              "derated",
              "full"
            ],
            "title": "Availability",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "initial_hours_offline_h": {
            "minimum": 0.0,
            "title": "Initial Hours Offline H",
            "type": "integer"
          },
          "initial_oil_inventory_bbl": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Oil Inventory Bbl"
          },
          "market_config": {
            "title": "Market Config",
            "type": "string"
          },
          "modules": {
            "$ref": "#/components/schemas/Modules",
            "default": {
              "capacity": false,
              "dispatch": false,
              "dp_commitment": false,
              "dual_fuel": false,
              "gas_basis": false,
              "hedges": false,
              "outages": false,
              "rt_settlement": false,
              "simulation": false
            }
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "plant_config": {
            "title": "Plant Config",
            "type": "string"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "unit_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Unit Ids",
            "type": "array"
          }
        },
        "required": [
          "name",
          "start_date",
          "end_date",
          "plant_config",
          "market_config",
          "unit_ids",
          "initial_hours_offline_h",
          "seed"
        ],
        "title": "Scenario",
        "type": "object"
      },
      "SolverSummary": {
        "description": "One commitment solver's outcome over the whole scenario window, for comparison.",
        "properties": {
          "energy_margin_usd": {
            "title": "Energy Margin Usd",
            "type": "number"
          },
          "hours_on": {
            "title": "Hours On",
            "type": "integer"
          },
          "output_mwh": {
            "title": "Output Mwh",
            "type": "number"
          },
          "solver": {
            "title": "Solver",
            "type": "string"
          },
          "starts": {
            "title": "Starts",
            "type": "integer"
          },
          "uplift_usd": {
            "title": "Uplift Usd",
            "type": "number"
          }
        },
        "required": [
          "solver",
          "energy_margin_usd",
          "uplift_usd",
          "starts",
          "hours_on",
          "output_mwh"
        ],
        "title": "SolverSummary",
        "type": "object"
      },
      "TableSummary": {
        "description": "Row count and coverage of one curated input table inside the scenario window.",
        "properties": {
          "first_local": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Local"
          },
          "last_local": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Local"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "title": "Locations",
            "type": "array"
          },
          "rows": {
            "title": "Rows",
            "type": "integer"
          },
          "snapshot_id": {
            "title": "Snapshot Id",
            "type": "string"
          },
          "table": {
            "title": "Table",
            "type": "string"
          }
        },
        "required": [
          "table",
          "rows",
          "first_local",
          "last_local",
          "locations",
          "snapshot_id"
        ],
        "title": "TableSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Roseton Ledger API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/params": {
      "get": {
        "description": "Plant config with provenance, flattened, plus the count of assumed parameters.",
        "operationId": "get_params_params_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParamsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Params"
      }
    },
    "/runs": {
      "get": {
        "description": "Stored runs, sorted by run id.",
        "operationId": "list_runs_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Runs Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs"
      },
      "post": {
        "description": "Execute a scenario synchronously and return its run id.",
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Run"
      }
    },
    "/runs/{run_id}": {
      "get": {
        "description": "Run metadata: config hash, seed, data snapshot ids, code version, invariant results.",
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunMeta"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run"
      }
    },
    "/runs/{run_id}/flow": {
      "get": {
        "description": "Flow-diagram payloads for every hour of one unit, optionally one local month (YYYY-MM).",
        "operationId": "get_flow_runs__run_id__flow_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "unit_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Unit Id"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HourFlow"
                  },
                  "title": "Response Get Flow Runs  Run Id  Flow Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Flow"
      }
    },
    "/runs/{run_id}/hour/{ts}": {
      "get": {
        "description": "Flow-diagram payload for one hour: every arrow's value plus the rows behind it.\n\n`ts` is an ISO timestamp with a UTC offset, e.g. 2025-01-15T17:00:00Z.",
        "operationId": "get_hour_runs__run_id__hour__ts__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ts",
            "required": true,
            "schema": {
              "title": "Ts",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "unit_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Unit Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HourFlow"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Hour"
      }
    },
    "/runs/{run_id}/ledger": {
      "get": {
        "description": "Ledger entries (grain=hour) or roll-up views by local day or month.",
        "operationId": "get_ledger_runs__run_id__ledger_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "grain",
            "required": false,
            "schema": {
              "default": "hour",
              "enum": [
                "hour",
                "day",
                "month"
              ],
              "title": "Grain",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "items": {
                        "$ref": "#/components/schemas/LedgerEntry"
                      },
                      "type": "array"
                    },
                    {
                      "items": {
                        "$ref": "#/components/schemas/LedgerRollup"
                      },
                      "type": "array"
                    }
                  ],
                  "title": "Response Get Ledger Runs  Run Id  Ledger Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ledger"
      }
    },
    "/runs/{run_id}/states": {
      "get": {
        "description": "Hourly plant states of the run.",
        "operationId": "get_states_runs__run_id__states_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlantState"
                  },
                  "title": "Response Get States Runs  Run Id  States Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get States"
      }
    }
  }
}
